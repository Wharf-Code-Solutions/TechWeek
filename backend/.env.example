# Copia como backend/.env y llena los valores (pídelos a Dev 1). Nunca subas .env.
SUPABASE_URL=
# Clave pública (anon/publishable): solo para abrir la sesión anónima desde el servidor
SUPABASE_ANON_KEY=
# Clave service_role: SOLO en el servidor. Jamás en el frontend ni en el repo.
SUPABASE_SERVICE_KEY=
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
