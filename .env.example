# Copia este archivo como .env.local y llena los valores (pídelos a Dev 1).
# Nunca subas .env.local al repositorio.
# El navegador ya no habla con Supabase: sus llaves viven en backend/.env.

# URL del backend FastAPI. Vacío en desarrollo (Vite redirige /api a localhost:8000).
VITE_API_URL=

# Mapbox · token público pk. restringido por dominio
VITE_MAPBOX_TOKEN=
